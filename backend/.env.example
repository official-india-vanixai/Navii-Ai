# ==============================================================================
# N.A.V.I.I Backend Environment Variables
# NEVER commit your real .env file with secrets into version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","vscode-webview://*"]

# OpenAI API Integration (Kept strictly on backend - never shared with client)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o

# Supabase Cloud PostgreSQL & Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# External Web Search API (Tavily, SerpApi, or Brave)
SEARCH_API_KEY=your_search_api_key_here
SEARCH_PROVIDER=tavily

# Rate Limiting & Cost Control Safeguards
MAX_PROMPT_TOKENS=8192
MAX_DAILY_REQUESTS_PER_USER=200
